#!/bin/sh /etc/rc.common
# NXChieu FRP Reverse TCP Tunnel Service (GL-XE300 -> Server 10.25.7.116:7000)

START=96
STOP=10
USE_PROCD=1

start_service() {
    [ -x /mnt/sda1/frp/frpc ] || return 0
    procd_open_instance
    procd_set_param command /mnt/sda1/frp/frpc -c /mnt/sda1/frp/frpc.toml
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
