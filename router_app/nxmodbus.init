#!/bin/sh /etc/rc.common
# NXChieu Modbus Web Studio & Gateway Procd Service

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
SCRIPT="/etc/nxmodbus/nxmodbus_server.py"

start_service() {
    # Ensure SD card data dir or fallback
    mkdir -p /mnt/sda1/modbus_data 2>/dev/null || mkdir -p /tmp/modbus_data
    
    procd_open_instance
    procd_set_param command $PROG $SCRIPT
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall python3 2>/dev/null
}
